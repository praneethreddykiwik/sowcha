# ---- Supabase (required for the admin page and live content) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# ---- Site ----
# Absolute URL used for OG/canonical tags. Optional on Vercel (VERCEL_URL is used).
NEXT_PUBLIC_SITE_URL=https://sowcha.com

# ---- Optional: legacy Cloudinary images ----
# Leave unset to fall back to the built-in botanical illustrations.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
